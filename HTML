<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GreenAI</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  background: #0b0f0c;
  color: white;
  scroll-behavior: smooth;
}

/* HEADER */
header {
  position: fixed;
  width: 100%;
  top: 0;
  padding: 15px 50px;
  display: flex;
  justify-content: space-between;
  background: rgba(0,0,0,0.8);
  backdrop-filter: blur(10px);
  z-index: 1000;
}

.logo {
  color: #00ff88;
  font-weight: 700;
  font-size: 22px;
}

nav a {
  margin: 0 15px;
  color: white;
  text-decoration: none;
  transition: 0.3s;
}

nav a:hover {
  color: #00ff88;
}

/* HERO */
.hero {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: url('https://images.unsplash.com/photo-1501004318641-b39e6451bec6') no-repeat center/cover;
  text-align: center;
}

.hero h1 {
  font-size: 60px;
  background: linear-gradient(#00ff88, white);
  -webkit-background-clip: text;
  color: transparent;
}

.hero p {
  max-width: 600px;
  margin: 20px 0;
}

.btn {
  padding: 12px 30px;
  background: #00ff88;
  border: none;
  color: black;
  font-weight: bold;
  cursor: pointer;
  border-radius: 6px;
  transition: 0.3s;
}

.btn:hover {
  transform: scale(1.1);
}

/* SECTIONS */
.section {
  padding: 100px 20px;
  text-align: center;
}

.cards {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.card {
  background: rgba(255,255,255,0.05);
  padding: 20px;
  width: 250px;
  border-radius: 10px;
  backdrop-filter: blur(10px);
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-10px);
}

/* CHATBOX */
.chatbox {
  position: fixed;
  bottom: 20px;
  right: 20px;
  width: 280px;
  background: #111;
  border-radius: 10px;
  padding: 10px;
}

.chatbox input {
  width: 70%;
  padding: 8px;
}

.chatbox button {
  width: 25%;
  background: #00ff88;
  border: none;
  padding: 8px;
}

</style>
</head>

<body>

<header>
  <div class="logo">GreenAI</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#about">About</a>
  </nav>
</header>

<!-- HERO -->
<div class="hero" id="home">
  <h1>Future of AI 🌍</h1>
  <p>Smart AI solutions for farmers, businesses, and environment.</p>
  <button class="btn" onclick="scrollToSection()">Explore</button>
</div>

<!-- SERVICES -->
<div class="section" id="services">
  <h2>Our Services</h2><br><br>
  <div class="cards">
    <div class="card">AI Tools 🤖</div>
    <div class="card">Automation ⚙️</div>
    <div class="card">Website Design 🌐</div>
  </div>
</div>

<!-- ABOUT -->
<div class="section" id="about">
  <h2>About Us</h2>
  <p>We build AI-powered solutions to grow businesses and help farmers in India.</p>
</div>

<!-- CHAT -->
<div class="chatbox">
  <b>Ask AI 🤖</b><br><br>
  <input id="input" placeholder="Ask something...">
  <button onclick="chat()">➤</button>
  <p id="output"></p>
</div>

<script>
function scrollToSection() {
  document.getElementById("services").scrollIntoView({behavior: "smooth"});
}

function chat() {
  let text = document.getElementById("input").value.toLowerCase();
  let reply = "I can help with AI and business.";

  if (text.includes("farmer")) {
    reply = "We provide AI tools for farmers 🌾";
  } else if (text.includes("hello")) {
    reply = "Hey 👋 Welcome to GreenAI!";
  } else if (text.includes("price")) {
    reply = "Our services start from ₹5000 💰";
  }

  document.getElementById("output").innerText = reply;
}
</script>

</body>
</html>
